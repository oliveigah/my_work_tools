#!/bin/sh
# Git credential helper installed by MWT. For hosts MWT holds a grant for, it
# answers only inside `mwt exec GRANT -- COMMAND`; MWT swaps the placeholder on
# the way out, after your rules (and approval) allow it. The placeholder is
# worthless anywhere else.
#
# MWT_TOKEN_GRANT lists the selected grants, innermost last (`mwt exec`
# nests). Outside them it answers nothing, so public clones stay anonymous,
# and for a host a grant covers it says, on stderr, how to use the grant:
# without it git would only fail to read a username.
[ "$1" = get ] || exit 0
inbox=$(cd -- "$(dirname -- "$0")/.." && pwd -P) || exit 0
host=""
while IFS= read -r line; do
  case "$line" in
    host=*) host="${line#host=}" ;;
    "") break ;;
  esac
done
[ -n "$host" ] || exit 0

answer=""
old_ifs=$IFS
IFS=,
for grant in ${MWT_TOKEN_GRANT:-}; do
  case $grant in '' | *[!a-zA-Z0-9_-]*) continue ;; esac
  if [ -r "$inbox/git/$grant" ] && grep -Fxq -- "$host" "$inbox/git/$grant" &&
     [ -r "$inbox/tokens/$grant" ]; then
    answer=$grant
  fi
done
IFS=$old_ifs

if [ -n "$answer" ]; then
  printf 'protocol=https\nhost=%s\nusername=x-access-token\npassword=%s\n' \
    "$host" "$(cat "$inbox/tokens/$answer")"
  exit 0
fi

covering=""
for file in "$inbox"/git/*; do
  [ -r "$file" ] && grep -Fxq -- "$host" "$file" && covering="$covering ${file##*/}"
done
if [ -n "$covering" ]; then
  set -- $covering
  echo "mwt: $host takes a token grant (${covering# }). If this needs it, run git through it: mwt exec $1 -- git ..." >&2
fi
exit 0
