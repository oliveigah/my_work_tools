#!/bin/sh
# Run by MWT inside the VM after every boot, as root, from /mnt/mwt/bin. POSIX
# sh, so it runs in an image without bash.
#
# MWT writes nothing of this machine's into the VM's storage itself: what it
# has for the VM, it copies into /mnt/mwt (a folder in the VM's memory)
# before this script runs, and this script, running in the VM, copies the
# parts that tools expect elsewhere:
#
#   - MWT's instructions for agents, as a block between two markers at the
#     top of ~/.claude/CLAUDE.md and ~/.codex/AGENTS.md. The rest of each
#     file is left alone;
#   - the /handoff command, which you type in an agent's thread to have it
#     hand off its work: ~/.claude/commands/handoff.md for Claude Code and
#     ~/.codex/prompts/handoff.md for Codex, the same file, MWT's own (each
#     boot puts it back as MWT has it);
#   - MWT's own tools over MCP (notes, diagrams, flash cards, HTTP samples):
#     `mwt mcp`, registered as the stdio server `mwt` with Codex, in
#     ~/.codex/config.toml, and with Claude Code, through its own command
#     (claude mcp add-json, user scope). One there already, MWT's or one you
#     changed, is left as it is;
#   - the memo tool, onto the VM's memory disk (/root/.optmem), with an
#     empty memory when there is none;
#   - which VM this is, when MWT names it: `mwt-boot ID CREATED IMAGE NAME`
#     writes /etc/mwt-vm, which `mwt vm` sends MWT to compare with the VM it
#     runs, and a line every interactive login shell prints with the answer;
#   - out of the VM's own Zed settings (~/.config/zed/settings.json), the
#     agents Claude (MWT) and Codex (MWT), which an older MWT put there for
#     an ACP shell it no longer has: only those two entries, the rest of the
#     file is left alone; and the adapters that shell installed for itself,
#     in /cache/mwt-acp;
#   - MWT's CA into Chromium's certificate store (~/.pki/nssdb), when the
#     image has certutil (libnss3-tools): Chromium, Playwright's included,
#     trusts that store, not the system's bundle, so without it every page
#     MWT reads would refuse to open. Only MWT's entry is put back.
#   - MWT's CA for containers, when the image has podman: a file of
#     /etc/containers/containers.conf.d that mounts it into every container
#     and build.
#
# It also starts `mwt ports --watch`, which tells MWT what listens in the VM
# so its servers open on the user's machine. It needs bash, ss and socat,
# keeps running after this script, and doesn't start twice.
#
# MWT_INBOX, HOME, MWT_ETC (for /etc) and MWT_CACHE (for /cache) can be set
# to try it outside a VM; then the watcher isn't started, and Claude Code's
# command isn't run.
set -u
inbox=${MWT_INBOX:-/mnt/mwt}
block=$inbox/agents-block.md
handoff=$inbox/handoff-command.md
begin='<!-- mwt:begin'
finish='<!-- mwt:end -->'

put_block() {
  local file=$1 partial
  mkdir -p "$(dirname "$file")" || return 1
  [ -e "$file" ] || : > "$file"
  partial=$(mktemp "$file.XXXXXX") || return 1

  if grep -qF -- "$begin" "$file"; then
    # Replaced where it was. A block that was never closed runs to the end.
    awk -v block="$block" -v begin="$begin" -v finish="$finish" '
      !inside && index($0, begin) == 1 {
        while ((getline line < block) > 0) print line
        inside = 1
        next
      }
      inside && index($0, finish) == 1 { inside = 0; next }
      !inside { print }
    ' "$file" > "$partial"
  else
    {
      cat "$block"
      [ -s "$file" ] && echo
      cat "$file"
    } > "$partial"
  fi

  mv "$partial" "$file"
}

status=0
etc=${MWT_ETC:-/etc}

if [ -n "${1:-}" ]; then
  {
    printf 'id=%s\n' "$1"
    printf 'created=%s\n' "${2:-}"
    printf 'image=%s\n' "${3:-}"
    printf 'name=%s\n' "${4:-}"
  } > "$etc/mwt-vm.new" && mv "$etc/mwt-vm.new" "$etc/mwt-vm" ||
    { echo "mwt-boot: could not write $etc/mwt-vm" >&2; status=1; }

  mkdir -p "$etc/profile.d" && {
    echo "# Written by MWT's boot script: which VM this is, in every interactive"
    echo "# login shell (Zed's terminals). \`mwt vm\` says it again."
    printf "mwt_vm_cli='%s'\n" "$inbox/bin/mwt"
    cat <<'PROFILE'
case $- in
  *i*)
    if [ -x "$mwt_vm_cli" ]; then
      mwt_vm_said=$(timeout 3 "$mwt_vm_cli" vm 2>&1)
      if [ $? -eq 0 ]; then
        printf '\033[2m%s\033[0m\n' "$mwt_vm_said"
      else
        printf '\033[1;31m%s\033[0m\n' "$mwt_vm_said"
      fi
      unset mwt_vm_said
    fi
    ;;
esac
unset mwt_vm_cli
PROFILE
  } > "$etc/profile.d/mwt-vm.sh" ||
    { echo "mwt-boot: could not write $etc/profile.d/mwt-vm.sh" >&2; status=1; }
fi

if [ -r "$block" ]; then
  for file in "$HOME/.claude/CLAUDE.md" "$HOME/.codex/AGENTS.md"; do
    put_block "$file" || { echo "mwt-boot: could not write $file" >&2; status=1; }
  done
fi

if [ -r "$handoff" ]; then
  for file in "$HOME/.claude/commands/handoff.md" "$HOME/.codex/prompts/handoff.md"; do
    mkdir -p "$(dirname "$file")" &&
      cp "$handoff" "$file.new" &&
      mv "$file.new" "$file" || { echo "mwt-boot: could not write $file" >&2; status=1; }
  done
fi

if [ -x "$inbox/bin/mwt" ]; then
  codex_config=$HOME/.codex/config.toml
  if ! grep -qs '^\[mcp_servers\.mwt\]' "$codex_config"; then
    mkdir -p "$(dirname "$codex_config")" && {
      [ -s "$codex_config" ] && echo
      echo "# MWT's own tools (notes, diagrams, flash cards, HTTP samples), from its boot script."
      echo '[mcp_servers.mwt]'
      printf 'command = "%s"\n' "$inbox/bin/mwt"
      echo 'args = ["mcp"]'
    } >> "$codex_config" || { echo "mwt-boot: could not write $codex_config" >&2; status=1; }
  fi

  if [ -z "${MWT_INBOX:-}" ] && command -v claude >/dev/null 2>&1; then
    said=$(timeout 60 claude mcp add-json --scope user mwt \
      "{\"type\":\"stdio\",\"command\":\"$inbox/bin/mwt\",\"args\":[\"mcp\"]}" 2>&1)
    case $said in
      *Added* | *"already exists"*) ;;
      *) echo "mwt-boot: could not add MWT's tools to Claude Code: $said" >&2 ;;
    esac
  fi
fi

if [ -x "$inbox/bin/memo" ]; then
  optmem=$HOME/.optmem
  mkdir -p "$optmem" &&
    cp "$inbox/bin/memo" "$optmem/memo.new" &&
    chmod 0755 "$optmem/memo.new" &&
    mv "$optmem/memo.new" "$optmem/memo" || { echo "mwt-boot: could not copy memo" >&2; status=1; }

  if [ ! -f "$optmem/memory/LOG.txt" ]; then
    MEMORY_DIR=$optmem/memory "$optmem/memo" init >/dev/null 2>&1 ||
      { echo "mwt-boot: memo init failed" >&2; status=1; }
  fi
fi

# An older MWT put two agents in Zed's settings, Claude (MWT) and Codex
# (MWT), each starting its ACP shell (bin/mwt-acp), which MWT no longer has:
# Zed would list agents that can't start. Each goes while it still starts
# that shell. A file Python can't read as JSON (comments, trailing commas)
# is left as it is, with a word on stderr. Not needed once every VM made
# before has booted with this.
zed_settings=${XDG_CONFIG_HOME:-$HOME/.config}/zed/settings.json
if [ -f "$zed_settings" ] && grep -qF 'mwt-acp' "$zed_settings"; then
  python3 -I - "$zed_settings" <<'PYTHON' ||
import json, os, sys

path = sys.argv[1]
try:
    with open(path) as f:
        settings = json.load(f)
except ValueError as error:
    sys.exit(f"{error}; left as it is")
servers = settings.get("agent_servers") if isinstance(settings, dict) else None
if isinstance(servers, dict):
    old = [
        name
        for name in ("Claude (MWT)", "Codex (MWT)")
        if isinstance(servers.get(name), dict)
        and str(servers[name].get("command", "")).endswith("/mwt-acp")
    ]
    if old:
        for name in old:
            del servers[name]
        if not servers:
            del settings["agent_servers"]
        partial = path + ".mwt-partial"
        with open(partial, "w") as f:
            json.dump(settings, f, indent=2)
            f.write("\n")
        os.replace(partial, path)
PYTHON
    { echo "mwt-boot: could not take MWT's old agents out of Zed's settings, $zed_settings" >&2; status=1; }
fi

# The adapters that shell installed for itself, apart from Zed's own (in
# Home): nothing starts them now, and they hold a few versions each.
old_adapters=${MWT_CACHE:-/cache}/mwt-acp
if [ -e "$old_adapters" ]; then
  rm -rf "$old_adapters" ||
    { echo "mwt-boot: could not remove the ACP shell's old adapters, $old_adapters" >&2; status=1; }
fi

if command -v certutil >/dev/null 2>&1 && [ -r "$inbox/ca.pem" ]; then
  nssdb=$HOME/.pki/nssdb
  if mkdir -p "$nssdb" &&
    { [ -f "$nssdb/cert9.db" ] || certutil -d "sql:$nssdb" -N --empty-password; }; then
    certutil -d "sql:$nssdb" -D -n "MWT agent sandbox CA" >/dev/null 2>&1
    certutil -d "sql:$nssdb" -A -t "C,," -n "MWT agent sandbox CA" -i "$inbox/ca.pem" ||
      { echo "mwt-boot: could not add MWT's CA to Chromium's certificate store" >&2; status=1; }
  else
    echo "mwt-boot: could not make Chromium's certificate store" >&2
    status=1
  fi
fi

# MWT's CA for containers, when the image has podman (its /etc/containers):
# every container and build gets it mounted under the name OpenSSL looks a
# CA up by in /etc/ssl/certs, its subject's hash, so it is trusted before
# the image has a bundle and a build that installs ca-certificates replaces
# nothing of it; and the bundle and CA at /run/mwt, which the variables of
# `podman run` point tools at (builds take mounts but no variables). None
# of it is committed into an image built here. The hash is the CA's, which
# MWT gives each identity, so it is written here rather than in the image.
if [ -d "$etc/containers" ] && [ -r "$inbox/ca.pem" ]; then
  if hash=$(openssl x509 -subject_hash -noout -in "$inbox/ca.pem" 2>/dev/null) &&
    mkdir -p "$etc/containers/containers.conf.d" && {
      echo "# Written by MWT's boot script: MWT's CA in every container and build."
      echo '[containers]'
      echo 'volumes = ['
      printf '  "%s:/etc/ssl/certs/%s.0:ro",\n' "$inbox/ca.pem" "$hash"
      printf '  "%s:/run/mwt/ca-bundle.pem:ro",\n' "$inbox/ca-bundle.pem"
      printf '  "%s:/run/mwt/ca.pem:ro",\n' "$inbox/ca.pem"
      echo ']'
      echo 'env = ['
      echo '  "SSL_CERT_FILE=/run/mwt/ca-bundle.pem",'
      echo '  "CURL_CA_BUNDLE=/run/mwt/ca-bundle.pem",'
      echo '  "REQUESTS_CA_BUNDLE=/run/mwt/ca-bundle.pem",'
      echo '  "NODE_EXTRA_CA_CERTS=/run/mwt/ca.pem",'
      echo ']'
    } > "$etc/containers/containers.conf.d/50-mwt.conf.new" &&
    mv "$etc/containers/containers.conf.d/50-mwt.conf.new" "$etc/containers/containers.conf.d/50-mwt.conf"; then
    :
  else
    echo "mwt-boot: could not give containers MWT's CA" >&2
    status=1
  fi
  # /run is on the VM's disk, not in memory: what podman kept there of the
  # containers before this boot would say they still run.
  [ -z "${MWT_INBOX:-}" ] && rm -rf /run/containers /run/libpod /run/crun
fi

if [ -z "${MWT_INBOX:-}" ] && [ -x "$inbox/bin/mwt" ] &&
  command -v bash >/dev/null 2>&1 && command -v ss >/dev/null 2>&1 &&
  command -v socat >/dev/null 2>&1; then
  # Its own session, so it outlives the exec that runs this script.
  setsid "$inbox/bin/mwt" ports --watch </dev/null >/dev/null 2>&1 &
fi

exit $status
