#!/bin/sh
# Sourced by bin/mwt_client before the release starts.
#
# MWT never runs as an Erlang node. With distribution on, any program that
# reaches epmd (port 4369, on every interface) and holds the cookie can run
# code inside MWT, and the cookie is the same in every copy of a package and
# readable by everyone on the machine. Nothing in MWT talks to other nodes, so
# it stays off, whatever the environment asks for.
export RELEASE_DISTRIBUTION=none
